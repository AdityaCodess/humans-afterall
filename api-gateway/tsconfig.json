{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    
    // 1. Delete the empty types array, or explicitly allow Node types
    "types": ["node"],
    
    // 2. Add this flag to allow importing CommonJS modules like Express
    "esModuleInterop": true,
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}